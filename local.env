LOG_LEVEL=info

# REST API configuration
PORT=:8080
WRITE_TIMEOUT=15s
SERVER_NAME=todo

# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_NAME=mydb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_SSL_MODE=disable

POSTGRES_POOL_MAX_CONNS=10
POSTGRES_POOL_MAX_CONN_LIFETIME=300s
POSTGRES_POOL_MAX_CONN_IDLE_TIME=150s

POSTGRES_AUTO_MIGRATE=true